    "alert.export.done.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is a one-way snapshot: importing it back will not restore cancel reasons, baseline colors or blocked states. The companion notes file lists everything that could not travel."
