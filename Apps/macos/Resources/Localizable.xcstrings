          "stringUnit": {
            "state": "translated",
            "value": "Kairo 的负责人是自由文本，不指向资源表；MSPDI 只有资源分配。负责人随导出丢弃：需要对方按资源算工时时请用「分配」而不是负责人。"
          }
        }
      }
    },
    "interop.export.detail.due_date": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kairo's due date only drives overdue display and never touches scheduling, while MSPDI's Deadline does. Writing it across would look successful while changing what it means, so it is dropped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kairo 的截止日只做逾期展示、不参与排期；MSPDI 的 Deadline 会参与排期。硬塞过去会「看起来成功、含义已换」，故按丢弃处理。"
          }
        }
      }
    },
    "interop.export.detail.implicit_dependency": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kairo pushes group dependencies down to every leaf in the subtree (effectiveDependencies). They are written as explicit links so the other tool schedules the same way, but those links no longer belong to a group: re-importing them turns them into the task's own dependencies."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kairo 的群组依赖会下推到子树每个叶子（effectiveDependencies）：导出时把它们写成显式相关性，对方打开后的排期与 Kairo 一致，但这几条边在对方文件里不再属于群组——回导会变成任务自身的依赖。"
          }
        }
      }
    },
    "interop.export.detail.planned_dates": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The schedule could not be computed (dependency cycle or no open session): planned dates were not written, so the other tool has to derive them from durations and links."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次排期算不出来（依赖环或会话未打开）：计划起止日期没有写出，对方只能按工期与相关性自行排。"
          }
        }
      }
    },
    "interop.export.detail.priority": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kairo's four priority levels have no counterpart in the MSPDI writer: priority is dropped and the other tool shows its default."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kairo 的四档优先级在 MSPDI 写出端没有对应字段：优先级随导出丢弃，对方看到的是默认优先级。"
          }
        }
      }
    },
    "interop.export.detail.tags": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task tags are a Kairo-local classification and MSPDI has no field for them: tags are dropped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务标签是 Kairo 的内部分类，MSPDI 没有对应字段：标签随导出丢弃。"
          }
        }
      }
    },
    "interop.export.unavailable": {
