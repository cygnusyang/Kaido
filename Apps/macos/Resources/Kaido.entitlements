<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- App Store 强制沙盒（P1）。站外 Developer ID 版不传这份文件，行为不变。 -->
  <!-- 手动签名时 Xcode 不会再替你注入这两项，但 provisioning profile 里有：
       缺了它 upload 会警告「signature is missing an application identifier」
       （TestFlight 直接被判不可用），补上与 profile 逐字一致的值。 -->
  <key>com.apple.application-identifier</key>
  <string>A6DS985SJJ.top.cygnusyang.kaido</string>
  <key>com.apple.developer.team-identifier</key>
  <string>A6DS985SJJ</string>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <!-- 打开/保存 .kaido、导出 CSV/XML/OmniPlan 都走用户选择面板。 -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <!-- 最近项目 / 启动时重开上次项目要用 security-scoped bookmark 才能跨重启访问。 -->
  <key>com.apple.security.files.bookmarks.app-scope</key>
  <true/>
  <!-- MCP 服务在 app 进程内监听 127.0.0.1（外部客户端连回来）。
       商店禁止让外部进程 spawn 子进程读用户文件，MCP 只能这样托管。 -->
  <key>com.apple.security.network.server</key>
  <true/>
  <!-- 命令行瘦客户端（同一二进制的 CLI 模式）也要它：它要连回本机服务。 -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
