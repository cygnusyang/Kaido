#!/bin/sh
# 启动 Kaido MCP 服务（stdio）。优先使用 KAIDO_MCP_BIN，其次仓库构建产物。
set -eu

if [ -n "${KAIDO_MCP_BIN:-}" ]; then
  exec "$KAIDO_MCP_BIN"
fi

root="$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)"
for candidate in "$root/.build/release/KaidoMCP" "$root/.build/debug/KaidoMCP"; do
  if [ -x "$candidate" ]; then
    exec "$candidate"
  fi
done

echo "kaido-mcp: 未找到 KaidoMCP 构建产物。请先运行 'swift build -c release'，或设置 KAIDO_MCP_BIN。" >&2
exit 1
