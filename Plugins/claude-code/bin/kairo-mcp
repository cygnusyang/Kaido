#!/bin/sh
# 启动 Kairo MCP 服务（stdio）。优先使用 KAIRO_MCP_BIN，其次仓库构建产物。
set -eu

if [ -n "${KAIRO_MCP_BIN:-}" ]; then
  exec "$KAIRO_MCP_BIN"
fi

root="$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)"
for candidate in "$root/.build/release/KairoMCP" "$root/.build/debug/KairoMCP"; do
  if [ -x "$candidate" ]; then
    exec "$candidate"
  fi
done

echo "kairo-mcp: 未找到 KairoMCP 构建产物。请先运行 'swift build -c release'，或设置 KAIRO_MCP_BIN。" >&2
exit 1
